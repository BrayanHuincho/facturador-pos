{
    "name": "facturador/sunat-gateway",
    "description": "Gateway SUNAT sin estado: firma y envía comprobantes con Greenter y genera sus PDF.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-soap": "*",
        "ext-zip": "*",
        "bacon/bacon-qr-code": "^3.1",
        "dompdf/dompdf": "^3.1.5",
        "greenter/lite": "^5.2",
        "illuminate/view": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "SunatGateway\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
